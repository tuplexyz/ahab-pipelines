from pathlib import Path

SAMPLES = ["A", "B"]
INPUTDIR = Path(config["inputdir"])
OUTDIR = Path(config["outdir"])

rule all:
    input:
        str(OUTDIR / "plots/quals.svg")

rule bwa_map:
    input:
        str(INPUTDIR / "genome.fa"),
        str(INPUTDIR / "samples/{sample}.fastq")
    output:
        str(OUTDIR / "mapped_reads/{sample}.bam")
    shell:
        "bwa mem {input:q} | samtools view -Sb - > {output:q}"


rule samtools_sort:
    input:
        str(OUTDIR / "mapped_reads/{sample}.bam")
    output:
        str(OUTDIR / "sorted_reads/{sample}.bam")
    shell:
        "samtools sort -O bam {input:q} > {output:q}"


rule samtools_index:
    input:
        str(OUTDIR / "sorted_reads/{sample}.bam")
    output:
        str(OUTDIR / "sorted_reads/{sample}.bam.bai")
    shell:
        "samtools index {input:q}"


rule bcftools_call:
    input:
        fa=str(INPUTDIR / "genome.fa"),
        bam=expand(str(OUTDIR / "sorted_reads/{sample}.bam"), sample=SAMPLES),
        bai=expand(str(OUTDIR / "sorted_reads/{sample}.bam.bai"), sample=SAMPLES)
    output:
          str(OUTDIR / "calls/all.vcf")
    shell:
        "bcftools mpileup -f {input.fa:q} {input.bam:q} | "
        "bcftools call -mv - > {output:q}"


rule plot_quals:
    input:
        str(OUTDIR / "calls/all.vcf")
    output:
        str(OUTDIR / "plots/quals.svg")
    script:
        "scripts/plot-quals.py"